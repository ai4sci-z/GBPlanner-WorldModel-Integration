<?xml version="1.0"?>
<package format="3">
  <name>gbplanner_node</name>
  <version>0.1.0</version>
  <description>M4: minimal ROS 2 shell around the ROS 1-free gbplanner core —
    one planner node (params bridge, Rrg + voxblox map manager, odometry in,
    planner/homing services, tick timers) plus a minimal PCI-replacement
    trigger node publishing /gbp/trajectory.</description>
  <maintainer email="jiaogali2580@gmail.com">ai4sci-z</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>gbplanner_core</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <depend>planner_msgs</depend>
  <depend>planner_semantic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
